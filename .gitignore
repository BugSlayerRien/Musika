# ---------- dependencies & build output ----------
node_modules
dist
dist-ssr
.vite
coverage
stats.html
.eslintcache

# ---------- secrets ----------
# The app itself needs no keys — the iTunes Search API is
# unauthenticated. But docs/NEXT-STEPS.md plans a backend with a
# database URL and a session secret, so keep these out ahead of time.
.env
.env.*
!.env.example

# ---------- machine-local editor / tool config ----------
# .claude/launch.json is shared project config and stays committed;
# per-machine settings and permission grants do not.
.claude/settings.local.json
.vscode
.idea
*.local
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS cruft ----------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- recorded sound packs ----------
# Downloaded per-machine. Most free libraries allow use but forbid
# redistribution, so they never get committed. See docs/SOUND-PACKS.md.
public/sfx/*
!public/sfx/README.txt
!public/sfx/manifest.example.json

# ---------- legacy ----------
# Binary that shipped alongside the original static site. Not source,
# and 31MB of it does not belong in git history.
legacy/*.zip

# ---------- deliberately NOT ignored ----------
# src/data/media.json  — generated by `npm run media`, but committed so
#                        a clean checkout runs with no network.
# public/aero/**       — generated by `npm run assets`, committed for
#                        the same reason.
# package-lock.json    — always committed; it is the build contract.
